generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  firstName            String     @db.VarChar(100)
  lastName             String     @db.VarChar(100)
  email                String     @unique @db.VarChar(320)
  phoneNumber          String     @unique @db.VarChar(20)
  secondaryPhoneNumber String?    @unique @db.VarChar(20)
  country              String     @db.VarChar(100)
  avatarKey            String?    @db.Text
  passwordHash         String     @db.VarChar(255)
  role                 UserRole   @default(USER)
  status               UserStatus @default(PENDING_VERIFICATION)

  kycVerified Boolean @default(false)

  heardFrom       String?   @db.VarChar(100)
  acceptedTermsAt DateTime
  emailVerifiedAt DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authRequestLogs         AuthRequestLog[]
  reviewedDeposits        Deposit[]                @relation("DepositReviewer")
  deposits                Deposit[]                @relation("UserDeposits")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sessions                Session[]

  wallet Wallet?

  balance          Decimal @default(0) @db.Decimal(18, 2)
  profit           Decimal @default(0) @db.Decimal(18, 2)
  affiliateBalance Decimal @default(0) @db.Decimal(18, 2)
  totalDeposit     Decimal @default(0) @db.Decimal(18, 2)

  walletTransactions    WalletTransaction[] @relation("UserWalletTransactions")
  walletAdjustmentsMade WalletTransaction[] @relation("AdminWalletTransactions")

  notifications Notification[]
  activityLogs  ActivityLog[]

  withdrawals          Withdrawal[] @relation("UserWithdrawals")
  processedWithdrawals Withdrawal[] @relation("WithdrawalProcessor")

  kycVerification KycVerification?

  subscriptions UserSubscription[]

  affiliateListings AffiliateListing[]

  affiliateNegotiationMessages AffiliateNegotiationMessage[]

  cartItems CartItem[]

  wishlistItems WishlistItem[]

  reviews ProductReview[]

  addresses Address[]

  orders   Order[]
  cart     Cart?
  wishlist Wishlist?

  @@index([phoneNumber])
  @@index([secondaryPhoneNumber])
  @@index([country])
  @@index([status])
  @@index([createdAt])
}

model Address {
  id String @id @default(cuid())

  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName String @db.VarChar(200)

  phoneNumber String @db.VarChar(20)

  alternatePhoneNumber String? @db.VarChar(20)

  addressLine1 String @db.VarChar(255)

  addressLine2 String? @db.VarChar(255)

  city String @db.VarChar(100)

  state String? @db.VarChar(100)

  country String @db.VarChar(100)

  postalCode String? @db.VarChar(20)

  label String? @db.VarChar(50)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isPrimary])
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  tokenHash      String    @unique @db.VarChar(64)
  userAgent      String?   @db.VarChar(512)
  ipAddress      String?   @db.VarChar(45)
  rememberMe     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model AuthRequestLog {
  id             String          @id @default(uuid()) @db.Uuid
  type           AuthRequestType
  userId         String?         @db.Uuid
  identifierHash String          @db.VarChar(64)
  createdAt      DateTime        @default(now())
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, identifierHash, createdAt])
  @@index([userId, type, createdAt])
}

model Wallet {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  availableBalance Decimal  @default(0) @db.Decimal(18, 2)
  lockedBalance    Decimal  @default(0) @db.Decimal(18, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions WalletTransaction[]
}

model WalletTransaction {
  id String @id @default(uuid()) @db.Uuid

  walletId String @db.Uuid
  userId   String @db.Uuid

  adminId String? @db.Uuid

  depositId    String? @unique @db.Uuid
  withdrawalId String? @unique @db.Uuid

  type WalletTransactionType

  amount Decimal @db.Decimal(18, 2)

  balanceBefore Decimal @db.Decimal(18, 2)
  balanceAfter  Decimal @db.Decimal(18, 2)

  description String? @db.VarChar(500)

  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  user User @relation("UserWalletTransactions", fields: [userId], references: [id], onDelete: Cascade)

  admin User? @relation("AdminWalletTransactions", fields: [adminId], references: [id], onDelete: Restrict)

  deposit Deposit? @relation(fields: [depositId], references: [id])

  withdrawal Withdrawal? @relation(fields: [withdrawalId], references: [id])
  order      Order?

  @@index([walletId])
  @@index([userId])
  @@index([adminId])
  @@index([type])
  @@index([createdAt])
}

model Deposit {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  depositMethodId String        @db.Uuid
  reviewedById    String?       @db.Uuid
  amount          Decimal       @db.Decimal(18, 2)
  reference       String        @unique @db.VarChar(100)
  receiptUrl      String?
  status          DepositStatus @default(PENDING)
  reviewNote      String?
  createdAt       DateTime      @default(now())
  reviewedAt      DateTime?
  updatedAt       DateTime      @updatedAt
  depositMethod   DepositMethod @relation(fields: [depositMethodId], references: [id])
  reviewer        User?         @relation("DepositReviewer", fields: [reviewedById], references: [id])
  user            User          @relation("UserDeposits", fields: [userId], references: [id], onDelete: Cascade)

  walletTransaction WalletTransaction?
  order             Order?

  @@index([userId])
  @@index([depositMethodId])
  @@index([reviewedById])
  @@index([status])
}

model DepositMethod {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  symbol        String   @db.VarChar(20)
  network       String   @db.VarChar(100)
  walletAddress String
  instructions  String?
  minimumAmount Decimal  @db.Decimal(18, 2)
  maximumAmount Decimal? @db.Decimal(18, 2)
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  iconKey   String? @db.Text
  qrCodeKey String? @db.Text

  deposits Deposit[]

  @@unique([symbol, network])
  @@index([isActive])
  @@index([displayOrder])
}

model Withdrawal {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation("UserWithdrawals", fields: [userId], references: [id], onDelete: Cascade)

  withdrawalMethodId String           @db.Uuid
  withdrawalMethod   WithdrawalMethod @relation(fields: [withdrawalMethodId], references: [id])

  amount        Decimal @db.Decimal(18, 2)
  fee           Decimal @default(0) @db.Decimal(18, 2)
  receiveAmount Decimal @db.Decimal(18, 2)

  reference String @unique @db.VarChar(100)

  balanceType WithdrawalBalanceType @default(WALLET)

  status WithdrawalStatus @default(PENDING)

  adminNote String? @db.Text

  destinationAddress String? @db.Text

  accountHolderName String? @db.VarChar(150)
  bankName          String? @db.VarChar(150)
  accountNumber     String? @db.VarChar(100)
  country           String? @db.VarChar(100)
  currency          String? @db.VarChar(20)
  bankAddress       String? @db.Text
  swiftBic          String? @db.VarChar(50)
  iban              String? @db.VarChar(100)
  routingNumber     String? @db.VarChar(100)
  sortCode          String? @db.VarChar(50)
  ifsc              String? @db.VarChar(50)

  processedById String? @db.Uuid
  processor     User?   @relation("WithdrawalProcessor", fields: [processedById], references: [id])

  processedAt DateTime?

  walletTransaction WalletTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([withdrawalMethodId])
  @@index([processedById])
  @@index([status])
  @@index([createdAt])
}

model WithdrawalMethod {
  id String @id @default(uuid()) @db.Uuid

  type WithdrawalMethodType

  name String @db.VarChar(100)

  symbol String? @db.VarChar(20)

  network String? @db.VarChar(100)

  placeholder String @db.Text

  iconKey String? @db.Text

  minimumAmount Decimal @db.Decimal(18, 2)

  maximumAmount Decimal? @db.Decimal(18, 2)

  processingFee Decimal @default(0) @db.Decimal(18, 2)

  processingFeeType ProcessingFeeType @default(FIXED)

  isActive Boolean @default(true)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  withdrawals Withdrawal[]

  @@unique([symbol, network])
  @@index([type])
  @@index([isActive])
  @@index([displayOrder])
}

model PlatformSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  title   String
  message String

  type   NotificationType
  isRead Boolean          @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model ActivityLog {
  id      String @id @default(uuid()) @db.Uuid
  adminId String @db.Uuid

  action ActivityLogAction

  entity   String
  entityId String

  description String?

  link String?

  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model KycVerification {
  id String @id @default(cuid())

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  dateOfBirth DateTime

  nationality String

  residentialAddress String
  city               String
  state              String
  postalCode         String
  country            String

  documentType KycDocumentType

  frontDocumentKey String
  backDocumentKey  String?

  selfieKey String

  status KycStatus @default(PENDING)

  rejectionReason String?

  reviewedAt DateTime?

  submittedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SubscriptionPlan {
  id String @id @default(cuid())

  name String

  slug String @unique

  description String?

  price Decimal @db.Decimal(18, 2)

  commissionRate Decimal @db.Decimal(5, 2)

  maxPublishedProducts Int

  priorityLevel Int

  badgeName String

  badgeColor String

  isActive Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  durationInDays Int

  subscriptions UserSubscription[]
}

model UserSubscription {
  id String @id @default(cuid())

  userId String @db.Uuid

  planId String

  amountPaid Decimal @db.Decimal(18, 2)

  commissionRate Decimal @db.Decimal(5, 2)

  maxPublishedProducts Int

  priority Int

  badgeName String

  badgeHex String

  status SubscriptionStatus @default(ACTIVE)

  startsAt DateTime

  expiresAt DateTime

  cancelledAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  affiliateListings AffiliateListing[]

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([expiresAt])
  @@index([planId])
}

model AffiliateListing {
  id String @id @default(cuid())

  userId String @db.Uuid

  subscriptionId String

  productId String

  status AffiliateListingStatus @default(PAUSED)

  totalSales Int @default(0)

  totalRevenue Decimal @default(0) @db.Decimal(18, 2)

  totalCommission Decimal @default(0) @db.Decimal(18, 2)

  lastSaleAt DateTime?

  publishedAt DateTime?

  removedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscription UserSubscription @relation(fields: [subscriptionId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  publicationStatus AffiliatePublicationStatus @default(DRAFT)

  interests AffiliateInterest[]

  submittedAt     DateTime?
  reviewedAt      DateTime?
  rejectionReason String?

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([subscriptionId])
}

model AffiliateTestBuyer {
  id String @id @default(cuid())

  name String @db.VarChar(200)

  imageKey String? @db.Text

  phone String @db.VarChar(20)

  email String? @db.VarChar(320)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interests AffiliateInterest[]

  @@index([name])
}

model AffiliateInterest {
  id String @id @default(cuid())

  affiliateListingId String

  testBuyerId String

  status AffiliateInterestStatus @default(PENDING)

  offeredPrice Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing AffiliateListing @relation(fields: [affiliateListingId], references: [id], onDelete: Cascade)

  testBuyer AffiliateTestBuyer @relation(fields: [testBuyerId], references: [id], onDelete: Cascade)

  messages AffiliateNegotiationMessage[]

  transaction AffiliateTransaction?

  @@index([affiliateListingId])
  @@index([testBuyerId])
  @@index([status])
  @@index([createdAt])
}

model AffiliateNegotiationMessage {
  id String @id @default(cuid())

  interestId String

  senderUserId String @db.Uuid

  message String @db.Text

  offeredPrice Decimal? @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  interest AffiliateInterest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  sender User @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([interestId, createdAt])
  @@index([senderUserId])
}

model AffiliateTransaction {
  id String @id @default(cuid())

  interestId String @unique

  agreedPrice Decimal @db.Decimal(18, 2)

  commissionRate Decimal @db.Decimal(5, 2)

  commissionAmount Decimal @db.Decimal(18, 2)

  status AffiliateTransactionStatus @default(AWAITING_PAYMENT)

  paidAt DateTime?

  escrowedAt DateTime?

  completedAt DateTime?

  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interest AffiliateInterest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model Product {
  id String @id @default(cuid())

  name        String
  slug        String @unique
  description String

  price          Decimal  @db.Decimal(18, 2)
  compareAtPrice Decimal? @db.Decimal(18, 2)

  averageRating Decimal @default(0) @db.Decimal(3, 2)
  totalRatings  Int     @default(0)
  totalSales    Int     @default(0)

  status   ProductStatus @default(DRAFT)
  featured Boolean       @default(false)

  metaTitle       String?
  metaDescription String?

  categoryId String

  category ProductCategory @relation(fields: [categoryId], references: [id])

  images         ProductImage[]
  variants       ProductVariant[]
  specifications ProductSpecification[]
  reviews        ProductReview[]

  affiliateListings AffiliateListing[]

  publishedAt DateTime?

  sku String? @unique

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
}

model ProductCategory {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?

  imageKey String?

  isActive Boolean @default(true)

  sortOrder Int @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model ProductImage {
  id String @id @default(cuid())

  productId String

  imageKey String

  altText String?

  sortOrder Int @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  isPrimary Boolean @default(false)

  @@index([productId])
  @@index([sortOrder])
}

model ProductVariant {
  id String @id @default(cuid())

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type ProductVariantType @default(DEFAULT)

  label String?

  imageKey String?

  images ProductVariantImage[]

  sizes ProductVariantSize[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([productId, label])
  @@index([productId])
}

model ProductVariantSize {
  id String @id @default(cuid())

  variantId String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  size String?

  sku String?

  price Decimal? @db.Decimal(18, 2)

  stock Int @default(0)

  reservedStock Int @default(0)

  incomingStock Int @default(0)

  allowPreorder Boolean @default(false)

  cartItems CartItem[]

  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([variantId, size])
  @@index([variantId])
}

model ProductVariantImage {
  id String @id @default(cuid())

  variantId String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  imageKey String

  altText String?

  sortOrder Int @default(0)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([sortOrder])
}

model ProductSpecification {
  id String @id @default(cuid())

  productId String

  name  String
  value String

  sortOrder Int @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
}

model ProductReview {
  id String @id @default(cuid())

  productId String

  customerName String

  rating Int

  title String?

  comment String

  verifiedPurchase Boolean @default(false)

  sortOrder Int @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.Uuid

  @@index([productId])
  @@index([rating])
  @@index([sortOrder])
}

model Cart {
  id String @id @default(cuid())

  userId String @unique @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id String @id @default(cuid())

  cartId String

  productId String

  variantSizeId String?

  quantity Int @default(1)

  status CartItemStatus @default(CART)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantSize ProductVariantSize? @relation(fields: [variantSizeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  userId String? @db.Uuid

  @@unique([cartId, productId, variantSizeId, status])
  @@index([cartId])
  @@index([productId])
  @@index([variantSizeId])
  @@index([status])
}

model Wishlist {
  id String @id @default(cuid())

  userId String @unique @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id String @id @default(cuid())

  wishlistId String

  productId String

  variantSizeId String?

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantSize ProductVariantSize? @relation(fields: [variantSizeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  userId String? @db.Uuid

  @@unique([wishlistId, productId, variantSizeId])
  @@index([wishlistId])
  @@index([productId])
  @@index([variantSizeId])
}

model Order {
  id String @id @default(cuid())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderNumber String @unique

  subtotal Decimal @db.Decimal(18, 2)

  discount Decimal @default(0) @db.Decimal(18, 2)

  total Decimal @db.Decimal(18, 2)

  paymentMethod PaymentMethod

  paymentStatus OrderPaymentStatus @default(PENDING)

  status OrderStatus @default(PENDING)

  walletTransactionId String?            @unique @db.Uuid
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id])

  cryptoDepositId String?  @unique @db.Uuid
  cryptoDeposit   Deposit? @relation(fields: [cryptoDepositId], references: [id])

  deliveryFullName String? @db.VarChar(200)

  deliveryPhoneNumber String? @db.VarChar(20)

  deliveryAlternatePhoneNumber String? @db.VarChar(20)

  deliveryAddressLine1 String? @db.VarChar(255)

  deliveryAddressLine2 String? @db.VarChar(255)

  deliveryCity String? @db.VarChar(100)

  deliveryState String? @db.VarChar(100)

  deliveryCountry String? @db.VarChar(100)

  deliveryPostalCode String? @db.VarChar(20)

  paidAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  notes String?

  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantSizeId String?
  variantSize   ProductVariantSize? @relation(fields: [variantSizeId], references: [id], onDelete: SetNull)

  quantity Int

  unitPrice Decimal @db.Decimal(18, 2)

  totalPrice Decimal @db.Decimal(18, 2)

  selectedColor String?

  selectedSize String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantSizeId])
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_DELETION
}

enum AuthRequestType {
  EMAIL_VERIFICATION_RESEND
  PASSWORD_RESET
}

enum DepositStatus {
  PENDING
